# Copy this file to .env and set your Ultimate 64's IP address.
# .env is listed in .gitignore and will NOT be committed to git.
ULTHOST = 192.168.1.x
# Storage to deploy to: usb0 (default), usb1 or SD
# ULTUSB = usb0

# Devices for `make e2e` (space separated; default: ULTHOST). Each needs
# `make deploy` first, for the MOD file.
# E2E_DEVICES = 192.168.1.x 192.168.1.y
